# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plan files
*.out
*.tfplan
*.plan

# Terraform variable files
*.tfvars
*.tfvars.json

# Keep example variable files
!*.example.tfvars

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# KEEP .terraform.lock.hcl
# Do NOT add it to .gitignore


# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend builds
frontend/build/
frontend/dist/

# Backend/runtime artifacts
backend/node_modules/
backend/*.log
backend/tmp/

# Build files
dist/
build/
.next/
out/
coverage/
.cache/

# General temp files
tmp/
*.tmp
*.temp

# Environment / secrets
.env
.env.*
!.env.example

# Credentials / keys
*.pem
*.key
*.crt
.aws/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
*~
